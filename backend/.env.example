# Nagarयोजना Backend Environment Configuration Template

# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Firebase Admin Service Account Key
# Option 1: Minified JSON string (e.g. {"type":"service_account",...})
# Option 2: Base64-encoded string of the service account JSON
# Option 3: Place the raw serviceAccountKey.json directly in the backend/ directory (gitignored)
FIREBASE_SERVICE_ACCOUNT_KEY=

# SMTP Email Dispatch Service (Nodemailer)
# If left blank, credentials will be securely logged to the console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@biratnagar.gov.np
SMTP_PASS=your-app-password
SMTP_FROM="Nagarयोजना Biratnagar" <no-reply@nagaryojana.gov.np>
